# Which chain the UI targets: 4663 = Robinhood Chain mainnet, 31337 = local anvil fork of mainnet
NEXT_PUBLIC_CHAIN_ID=4663
# Optional private RPC (e.g. Alchemy). Defaults to the public RPC / http://127.0.0.1:8545 for 31337.
NEXT_PUBLIC_RPC_URL=
# WalletConnect Cloud project id (https://cloud.reown.com). Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $MIRR address once launched. EMPTY = every token feature (staking, verified badges) is hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock: comma-separated ISO country codes (uses Vercel's x-vercel-ip-country header).
# Example (Robinhood Stock Token restricted jurisdictions): US,CA,GB,CH,CU,BY,IR,KP,RU,SY,UA,SS,SD,MM,VE
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
